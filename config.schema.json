{
  "pluginAlias": "PranaLocal",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Control Prana locally over Wi-Fi. Requires device firmware 49 or newer. No Prana account is needed. Give each device a stable ID and reserve its IP address in the router.",
  "schema": {
    "type": "object",
    "properties": {
      "name": { "title": "Platform name", "type": "string", "default": "Prana Local" },
      "language": { "title": "Accessory label language", "type": "string", "enum": ["en", "it"], "default": "en" },
      "pollInterval": { "title": "Polling interval (seconds)", "type": "integer", "minimum": 5, "maximum": 300, "default": 10 },
      "devices": {
        "title": "Prana units", "type": "array", "minItems": 1,
        "items": {
          "type": "object", "required": ["host", "id", "name"],
          "properties": {
            "id": { "title": "Stable ID", "type": "string", "minLength": 1, "description": "Unique permanent label, e.g. kitchen. Keep this unchanged when the IP changes." },
            "name": { "title": "Name in Apple Home", "type": "string", "minLength": 1, "default": "Prana ventilation" },
            "host": { "title": "IP address or hostname", "type": "string", "minLength": 1, "description": "No http:// prefix. Use a DHCP reservation for reliable access." },
            "port": { "title": "Local HTTP port", "type": "integer", "minimum": 1, "maximum": 65535, "default": 80 },
            "model": { "title": "Model label (optional)", "type": "string", "description": "The label printed on the unit, e.g. 210G ERP PRO M23." },
            "separateFans": { "title": "Also expose separate supply and extract controls", "type": "boolean", "default": false },
            "exposeHeater": { "title": "Expose mini heater switch", "type": "boolean", "default": true },
            "co2Threshold": { "title": "Equivalent CO2 abnormal threshold (ppm)", "type": "integer", "minimum": 400, "maximum": 10000, "default": 1000 },
            "timeout": { "title": "Request timeout (milliseconds)", "type": "integer", "minimum": 500, "maximum": 30000, "default": 5000 }
          }
        }
      }
    }
  }
}
